// Règles de la base Firestore : à copier dans la console Firebase
// (Firestore Database > Règles), en remplaçant les deux emails par les vôtres.
// Seuls ces deux comptes peuvent lire ou écrire le carnet.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email in ['EMAIL-DE-DAMIEN', 'EMAIL-DU-PERE'];
    }
  }
}
